# ----------------------------------------------------------
# PDF Duplex Merge - files excluded from the repository
# ----------------------------------------------------------

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual environments - never commit these.
# Recreate with:  py -3.14 -m venv venv314
venv/
venv314/
.venv/
env/

# Build artefacts (regenerated by packaging\build.bat)
build/
dist/
*.spec

# PDFs produced by running the app
output/

# Local logs and scratch files
*.log
info.txt

# Office / planning documents not part of the shipped tool
*.docx
*.xlsx

# Operating-system cruft
Thumbs.db
.DS_Store

# Poppler IS intentionally bundled and distributed (see
# THIRD-PARTY-NOTICES.txt). Do not ignore it.
# tools/poppler/   <-- leave this commented out

